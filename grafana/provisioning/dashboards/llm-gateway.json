{
  "title": "LLM Gateway",
  "uid": "llm-gateway",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(gateway_request_latency_seconds_bucket[5m])) by (le, backend))", "legendFormat": "p50 {{backend}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(gateway_request_latency_seconds_bucket[5m])) by (le, backend))", "legendFormat": "p95 {{backend}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(gateway_request_latency_seconds_bucket[5m])) by (le, backend))", "legendFormat": "p99 {{backend}}", "refId": "C" }
      ]
    },
    {
      "id": 2,
      "title": "Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(gateway_requests_total[1m])) by (backend, status)", "legendFormat": "{{backend}} / {{status}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 0.2 },
          { "color": "green", "value": 0.5 }
        ]}
      }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(gateway_cache_hits_total[5m])) / (sum(rate(gateway_cache_hits_total[5m])) + sum(rate(gateway_cache_misses_total[5m])))", "legendFormat": "hit ratio", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.01 },
          { "color": "red", "value": 0.05 }
        ]}
      }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(gateway_requests_total{status=\"error\"}[5m])) / sum(rate(gateway_requests_total[5m]))", "legendFormat": "error rate", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Fallback Events (5m rate)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 0.01 }
        ]}
      }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(gateway_fallback_total[5m]))", "legendFormat": "fallbacks/sec", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Rate-Limited Requests (5m rate)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 0.01 }
        ]}
      }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(gateway_rate_limited_total[5m]))", "legendFormat": "429s/sec", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Token Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(gateway_tokens_total[1m])) by (backend, direction)", "legendFormat": "{{backend}} / {{direction}}", "refId": "A" }
      ]
    }
  ]
}
